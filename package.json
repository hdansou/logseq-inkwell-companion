{
  "name": "logseq-inkwell-companion",
  "version": "0.1.0",
  "description": "Fixes for Logseq DB graphs that CSS alone can't make: export tag and query tables to CSV or JSON, fit embedded tweets. Each fix has its own switch. Works with any theme.",
  "author": "Danzu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/logseq-inkwell-companion.git"
  },
  "homepage": "https://github.com/hdansou/logseq-inkwell-companion#readme",
  "bugs": {
    "url": "https://github.com/hdansou/logseq-inkwell-companion/issues"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "logseq-db",
    "inkwell",
    "export",
    "csv"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "predev": "rm -rf dist",
    "dev": "vite --port 8295 --strictPort",
    "preview": "vite preview --port 8296 --strictPort",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "logseq": {
    "id": "logseq-inkwell-companion",
    "title": "Inkwell Companion",
    "icon": "./icon.svg",
    "main": "dist/index.html",
    "supportsDB": true,
    "supportsDBOnly": true,
    "minSDKVersion": "0.3.4"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "lodash-es": "^4.18.1"
  }
}
